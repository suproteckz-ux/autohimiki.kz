# ══════════════════════════════════════════════════════════
# autohimiki.kz — .env шаблон
# Скопировать в .env и заполнить значения
# ══════════════════════════════════════════════════════════

APP_NAME="Autohimiki.kz"
APP_ENV=production
APP_KEY=
APP_DEBUG=false
APP_URL=https://autohimiki.kz
APP_TIMEZONE=Asia/Almaty

APP_LOCALE=ru
APP_FALLBACK_LOCALE=ru
APP_FAKER_LOCALE=ru_RU

# ── Логи ──────────────────────────────────────────────────
LOG_CHANNEL=daily
LOG_LEVEL=error
LOG_DAILY_DAYS=14

# ── База данных ───────────────────────────────────────────
DB_CONNECTION=mysql
DB_HOST=localhost
DB_PORT=3306
DB_DATABASE=autohimiki
DB_USERNAME=autohimiki_user
DB_PASSWORD=
DB_CHARSET=utf8mb4
DB_COLLATION=utf8mb4_unicode_ci

# ── Кэш ──────────────────────────────────────────────────
CACHE_STORE=file

# ── Очереди ──────────────────────────────────────────────
QUEUE_CONNECTION=database

# ── Сессии ───────────────────────────────────────────────
SESSION_DRIVER=file
SESSION_LIFETIME=120
SESSION_SECURE_COOKIE=true
SESSION_SAME_SITE=lax

# ── Файловое хранилище ───────────────────────────────────
FILESYSTEM_DISK=public

# ── Изображения (Imagick или Gd) ─────────────────────────
IMAGE_DRIVER=\Intervention\Image\Drivers\Imagick\Driver

# ── Почта ────────────────────────────────────────────────
MAIL_MAILER=smtp
MAIL_HOST=smtp.gmail.com
MAIL_PORT=587
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_ENCRYPTION=tls
MAIL_FROM_ADDRESS=info@autohimiki.kz
MAIL_FROM_NAME="Autohimiki.kz"

# ── Прочее ───────────────────────────────────────────────
BROADCAST_CONNECTION=log
